      },
      "LangToggle": {
        "replaces": []
      },
      "Nav": {
        "replaces": []
      },
      "RadarRow": {
        "replaces": []
      }
    },
    "tokens": [
      "--accent",
      "--accent-boost",
      "--antes-err-fg",
      "--antes-tag-bg",
      "--antes-tag-fg",
      "--azul-profundo",
      "--azul-profundo-2",
      "--border-on-dark",
      "--border-on-light",
      "--border-on-light-strong",
      "--branco",
      "--ciano",
      "--ciano-suave",
      "--cinza-claro",
      "--cinza-escuro",
      "--cinza-texto",
      "--claro-escuro",
      "--font-body",
      "--font-display",
      "--font-mono",
      "--font-serif-italic",
      "--fs-body",
      "--fs-eyebrow",
      "--fs-h1",
      "--fs-h2",
      "--fs-h3",
      "--fs-lead",
      "--r-lg",
      "--r-md",
      "--r-pill",
      "--r-sm",
      "--r-xl",
      "--r-xs",
      "--shadow-card",
      "--shadow-dark",
      "--shadow-glow",
      "--shadow-glow-hover",
      "--surface-alt",
      "--surface-calm",
      "--surface-dark",
      "--surface-dark-2",
      "--surface-page",
      "--text-body",
