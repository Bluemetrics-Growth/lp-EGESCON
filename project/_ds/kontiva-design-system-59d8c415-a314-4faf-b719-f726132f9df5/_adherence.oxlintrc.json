      "--branco": "color",
      "--cinza-claro": "color",
      "--cinza-texto": "color",
      "--cinza-escuro": "color",
      "--claro-escuro": "color",
      "--accent-boost": "other",
      "--text-primary": "font",
      "--text-body": "font",
      "--text-secondary": "font",
      "--text-on-dark": "font",
      "--surface-page": "color",
      "--surface-alt": "color",
      "--surface-calm": "color",
      "--surface-dark": "color",
      "--surface-dark-2": "color",
      "--accent": "color",
      "--border-on-light": "color",
      "--border-on-light-strong": "color",
      "--border-on-dark": "color",
      "--antes-err-fg": "color",
      "--antes-tag-fg": "color",
      "--antes-tag-bg": "color",
      "--font-display": "font",
